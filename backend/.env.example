# Sao chép thành .env rồi điền giá trị thật

DATABASE_URL=postgresql+psycopg://itonsite:itonsite@localhost:5432/itonsite

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CREDENTIAL_KEY=

APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_DIR=uploads

# Phân loại sự cố bằng Gemini API; để trống thì dùng bộ phân loại theo từ khóa
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Thông báo Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
