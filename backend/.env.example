# Sao chép thành .env rồi điền giá trị thật

DATABASE_URL=postgresql+psycopg://itonsite:itonsite@localhost:5432/itonsite

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CREDENTIAL_KEY=

APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
# Thư mục bản dựng giao diện khi backend phục vụ luôn giao diện (image Docker gộp)
FRONTEND_DIR=
# Bản trình diễn: lần chạy đầu nạp dữ liệu mẫu, quản trị viên nạp lại được dữ liệu mẫu ở trang Cấu hình
DEMO_DATA=false

# Phân loại sự cố bằng Gemini API; để trống thì dùng bộ phân loại theo từ khóa
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Thông báo Telegram; để trống TELEGRAM_WEBHOOK_SECRET thì khóa webhook sinh từ JWT_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Hoặc gửi email qua HTTPS bằng Google Apps Script (infra/email-relay/Code.gs), dùng khi máy chủ chặn cổng SMTP
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
