# Để trống VITE_API_URL thì giao diện chạy bằng dữ liệu giả lập trong trình duyệt
VITE_API_URL=/api
# Địa chỉ backend mà máy chủ phát triển của Vite chuyển tiếp /api và /media tới
VITE_PROXY_TARGET=http://localhost:8000
# Hiện các nút đăng nhập nhanh bằng tài khoản dùng thử (chỉ bật khi đã nạp dữ liệu trình diễn)
VITE_DEMO_ACCOUNTS=false
