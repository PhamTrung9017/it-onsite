# Sao chép thành infra/.env rồi điền giá trị thật
# Tạo chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
DB_PASSWORD=
JWT_SECRET=
CREDENTIAL_KEY=
APP_URL=http://localhost:8080
# true: hiện nút đăng nhập nhanh tài khoản dùng thử (chỉ dùng khi đã nạp dữ liệu trình diễn)
DEMO_ACCOUNTS=false

GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
